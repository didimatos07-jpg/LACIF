rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read and write access to the specific site configuration document
    // This allows client-side pericial password validation to save and synchronize state 
    // seamlessly on Vercel deployments without requiring custom authorized auth domains.
    match /config/{configId} {
      allow read, write: if true;
    }

    // Secure Quiz Results subcollection implementing Attribute-Based Access Control
    match /quiz_results/{resultId} {
      // Allow creation if user is signed in and claims the write with their matching authorized UID
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      // Allow reading list/documents only for the corresponding logged-in owner
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      
      // Updates and deletions are barred to ensure zero-trust compliance on academic exams
      allow update, delete: if false;
    }
  }
}
